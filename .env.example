# Postgres (Neon vía la integración de Storage de Vercel). En desarrollo se
# obtienen con `npx vercel env pull .env.local --environment=preview` — no
# hace falta cargarlas a mano. DATABASE_URL_UNPOOLED es la que usa
# drizzle-kit (push/generate); DATABASE_URL es la pooled, la que usa la app.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Secreto para firmar la cookie de sesión (src/lib/auth/jwt.ts). Generarlo con:
#   openssl rand -base64 32
# Distinto por entorno — nunca el mismo valor en dev y en la cuenta de
# REINER (ver docs/04-runbook-traspaso.md C4, "Regenerar AUTH_SECRET").
AUTH_SECRET=

# Vercel Blob — adjuntos de ingeniería (planos, procedimientos, imágenes),
# Release 3 §10. Conectado el 2026-09-28 (Storage → Create Database → Blob
# en el dashboard de Vercel). Al traspasar a la cuenta de REINER hay que
# recrear el store ahí y volver a pegar estos tres valores — no se heredan
# solos con la transferencia del proyecto (mismo gotcha que Neon, ver
# docs/04-runbook-traspaso.md C3).
#
# BLOB_PUBLIC_BASE_URL es la base pública del store (ej.
# "https://<hash>.public.blob.vercel-storage.com", SIN barra final) — en la
# base sólo se guarda el `pathname` de cada adjunto (runbook §A5: la URL
# completa cambia si el store cambia), y esta env var es lo único que hay
# que actualizar el día del traspaso para que todos los adjuntos sigan
# resolviendo, sin tocar una sola fila de la base.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE_URL=
